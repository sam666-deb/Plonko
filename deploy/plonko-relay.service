# systemd unit for the Plonko relay server.
# Copy to /etc/systemd/system/, adjust User and WorkingDirectory, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now plonko-relay
[Unit]
Description=Plonko relay server
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Plonko
Environment=PORT=8787
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
