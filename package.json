{
  "name": "plonko",
  "private": true,
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w @plonko/server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client",
    "typecheck": "npm run typecheck -w @plonko/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
